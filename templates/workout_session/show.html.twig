{% extends 'base.html.twig' %}

{% block title %}WorkoutSession{% endblock %}

{% block body %}
    <h1>WorkoutSession</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ workout_session.id }}</td>
            </tr>
            <tr>
                <th>Star_time</th>
                <td>{{ workout_session.startTime ? workout_session.startTime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>End_time</th>
                <td>{{ workout_session.endTime ? workout_session.endTime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_workout_session_index') }}">back to list</a>

    <a href="{{ path('app_workout_session_edit', {'id': workout_session.id}) }}">edit</a>

    {{ include('workout_session/_delete_form.html.twig') }}
{% endblock %}
